@model PointVm
@{ ViewData["Title"] = Model.MaDiem == 0 ? "Thêm điểm" : "Sửa điểm"; }
@section Head { <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" /> }
<h3 class="page-title">@ViewData["Title"]</h3>
<form asp-action="Save" method="post" enctype="multipart/form-data" class="card p-4">
    <input type="hidden" asp-for="MaDiem" /><input type="hidden" asp-for="HinhAnh" />
    <div asp-validation-summary="All" class="text-danger small"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Tên điểm *</label><input asp-for="TenDiem" class="form-control" />
            <div class="row g-2 mt-1">
                <div class="col-6"><label class="form-label">Loại điểm *</label><select asp-for="MaLoai" asp-items="ViewBag.Loai" class="form-select"></select></div>
                <div class="col-6"><label class="form-label">Tầng / vị trí</label><input asp-for="Tang" class="form-control" placeholder="VD: Tầng 1" /></div>
            </div>
            <label class="form-label mt-2">Giờ làm việc</label><input asp-for="GioLamViec" class="form-control" placeholder="07:30 – 11:30, 13:30 – 17:00" />
            <label class="form-label mt-2">Từ khóa chức năng (phân tách bằng dấu phẩy)</label>
            <input asp-for="TuKhoa" class="form-control" placeholder="nộp học phí, hóa đơn" />
            <label class="form-label mt-2">Hình ảnh (JPG/PNG ≤ 5 MB)</label><input asp-for="Anh" type="file" accept=".jpg,.jpeg,.png" class="form-control" />
            @if (!string.IsNullOrEmpty(Model.HinhAnh)) { <img src="@Model.HinhAnh" class="mt-2 rounded" style="max-height:140px" /> }
        </div>
        <div class="col-md-6">
            <label class="form-label">Vị trí * (bấm lên bản đồ để chọn)</label>
            <div id="map" class="map-picker"></div>
            <div class="row g-2 mt-1">
                <div class="col-4"><label class="form-label small">Vĩ độ</label><input asp-for="ViDo" class="form-control form-control-sm" /></div>
                <div class="col-4"><label class="form-label small">Kinh độ</label><input asp-for="KinhDo" class="form-control form-control-sm" /></div>
                <div class="col-4"><label class="form-label small">Bán kính (m)</label><input asp-for="BanKinh" type="number" min="0" max="30" step="1" inputmode="numeric" class="form-control form-control-sm" onkeydown="if(['-','+','e','E','.',','].includes(event.key)) event.preventDefault();" oninput="this.value=this.value.replace(/[^0-9]/g,''); if(this.value!=='' &amp;&amp; +this.value&gt;30) this.value=30;" onpaste="setTimeout(()=&gt;this.dispatchEvent(new Event('input')),0)" /><span asp-validation-for="BanKinh" class="text-danger small"></span></div>
            </div>
        </div>
    </div>
    <div class="mt-4">
        <button class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-light">Hủy</a>
    </div>
</form>
@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    const lat = document.getElementById('ViDo'), lng = document.getElementById('KinhDo'), r = document.getElementById('BanKinh');
    const num = v => parseFloat(String(v).replace(',', '.'));
    const start = [num(lat.value) || 10.7598, num(lng.value) || 106.6823];
    const map = L.map('map', { maxZoom: 21 }).setView(start, 18);
    const googleDuong = L.tileLayer('https://mt{s}.google.com/vt/lyrs=m&hl=vi&x={x}&y={y}&z={z}', { subdomains: '0123', maxZoom: 21, attribution: '© Google' });
    const googleVeTinh = L.tileLayer('https://mt{s}.google.com/vt/lyrs=y&hl=vi&x={x}&y={y}&z={z}', { subdomains: '0123', maxZoom: 21, attribution: '© Google' });
    const cartoDuong = L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { subdomains: 'abcd', maxZoom: 21, maxNativeZoom: 20, attribution: '© OpenStreetMap © CARTO' });
    googleDuong.addTo(map);
    L.control.layers({ 'Google – đường phố': googleDuong, 'Google – vệ tinh': googleVeTinh, 'Bản đồ CARTO': cartoDuong }).addTo(map);
    let marker = null, circle = null;
    function place(p) {
        lat.value = p[0].toFixed(6); lng.value = p[1].toFixed(6);
        if (!marker) { marker = L.marker(p, { draggable: true }).addTo(map); marker.on('dragend', e => { const ll = e.target.getLatLng(); place([ll.lat, ll.lng]); }); }
        else marker.setLatLng(p);
        if (!circle) circle = L.circle(p, { radius: num(r.value) || 30 }).addTo(map); else circle.setLatLng(p);
    }
    if (lat.value) place(start);
    map.on('click', e => place([e.latlng.lat, e.latlng.lng]));
    r.addEventListener('input', () => circle && circle.setRadius(num(r.value) || 30));
</script>
}
