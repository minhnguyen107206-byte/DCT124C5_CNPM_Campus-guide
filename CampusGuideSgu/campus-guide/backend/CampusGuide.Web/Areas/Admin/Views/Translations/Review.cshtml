@model NoiDung
@{
    ViewData["Title"] = "Duyệt bản dịch";
    NoiDung? goc = ViewBag.Goc;
    var audio = Model.Audios.OrderByDescending(a => a.NgaySinh).FirstOrDefault();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="page-title mb-0">@Model.Diem?.TenDiem · @Model.NgonNgu?.Co @Model.NgonNgu?.TenNgonNgu @Ui.Badge(Model.TrangThai)</h3>
    <a asp-action="Index" class="btn btn-light">← Danh sách</a>
</div>
@if (goc != null && goc.PhienBanGoc != Model.PhienBanGoc)
{
    <div class="alert alert-info">Bản gốc đã ở phiên bản @goc.PhienBanGoc, bản dịch này dịch từ phiên bản @Model.PhienBanGoc. Nên dịch lại ở trang Nội dung của điểm.</div>
}
@if (!string.IsNullOrEmpty(Model.LyDoTuChoi)) { <div class="alert alert-danger">Lý do từ chối: @Model.LyDoTuChoi</div> }
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card p-4 h-100">
            <h6 class="text-muted">Bản gốc tiếng Việt</h6>
            <div class="fw-bold mb-2">@goc?.TieuDe</div>
            <div style="white-space:pre-wrap">@goc?.VanBan</div>
        </div>
    </div>
    <div class="col-lg-6">
        <form method="post" asp-action="Save" asp-route-id="@Model.MaNoiDung" class="card p-4 h-100">
            <h6 class="text-muted">Bản dịch (@Model.MaNgonNgu)</h6>
            <input name="tieuDe" id="trTitle" value="@Model.TieuDe" class="form-control mb-2 fw-bold" />
            <textarea name="vanBan" id="trText" rows="9" class="form-control">@Model.VanBan</textarea>
            @if (audio != null)
            {
                <div class="small text-muted mt-3">Audio: @audio.GiongDoc?.TenGiongAPI · @audio.ThoiLuong giây · @audio.NgaySinh.ToLocalTime().ToString("dd/MM HH:mm")</div>
                <audio controls src="@audio.DuongDan" class="w-100"></audio>
            }
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-outline-primary"><i class="bi bi-save"></i> Lưu bản dịch</button>
                <button type="button" class="btn btn-outline-secondary" data-speak data-lang="@Model.MaNgonNgu" data-title="#trTitle" data-text="#trText"><i class="bi bi-volume-up"></i> Nghe thử</button>
            </div>
            <div class="speak-note small text-muted mt-2">Nghe bằng giọng của trình duyệt (giống app đọc bằng giọng của điện thoại).</div>
        </form>
    </div>
</div>
<div class="card p-3 mt-3">
    <div class="d-flex flex-wrap gap-3 align-items-end">
        <form method="post" asp-action="Approve" asp-route-id="@Model.MaNoiDung">
            <button class="btn btn-success btn-lg"><i class="bi bi-check2-circle"></i> Duyệt</button>
        </form>
        <form method="post" asp-action="Reject" asp-route-id="@Model.MaNoiDung" class="d-flex gap-2 align-items-end ms-auto">
            <div><label class="form-label small mb-0">Lý do từ chối</label><input name="lyDo" class="form-control" style="min-width:260px" /></div>
            <button class="btn btn-outline-danger">Từ chối</button>
        </form>
    </div>
</div>
