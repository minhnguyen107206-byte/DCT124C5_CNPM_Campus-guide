@{
    ViewData["Title"] = "QR trang web";
    string link = ViewBag.Link;
    bool reachable = ViewBag.Reachable;
    bool tunnel = ViewBag.Tunnel;
}
@section Head {
<style>
    .site-poster { max-width: 420px; border-radius: 24px; overflow: hidden; background: #fff; box-shadow: 0 12px 32px rgb(16 37 66 / 14%); }
    .site-poster .top { background: linear-gradient(135deg, #1d4ed8, #7c3aed 60%, #f97316); color: #fff; padding: 24px 24px 76px; text-align: center; }
    .site-poster .top .brand { font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; opacity: .9; }
    .site-poster .top h2 { font-weight: 800; font-size: 1.6rem; margin: 6px 0 4px; }
    .site-poster .box { margin: -58px auto 0; width: 280px; background: #fff; border-radius: 22px; padding: 14px; border: 3px solid #e6edf9; box-shadow: 0 10px 26px rgb(16 37 66 / 18%); }
    .site-poster .box img { width: 100%; display: block; }
    .site-poster .bottom { text-align: center; padding: 16px 22px 22px; }
    .site-poster .langs { font-size: .95rem; letter-spacing: .1em; }
    @@media print {
        body * { visibility: hidden; }
        .site-poster, .site-poster * { visibility: visible; }
        .site-poster { position: absolute; left: 50%; top: 20px; transform: translateX(-50%); box-shadow: none; }
    }
</style>
}
<h3 class="page-title">Mã QR trang web người dùng</h3>
<p class="text-muted">In mã này dán ở cổng trường, quầy tiếp đón, tờ rơi… Khách quét bằng camera điện thoại là mở thẳng Trang chủ CampusGuide – không cần cài app, không cần đăng nhập.</p>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="site-poster">
            <div class="top">
                <div class="brand">Trường Đại học Sài Gòn</div>
                <h2>CampusGuide SGU</h2>
                <div>Hướng dẫn tham quan khuôn viên</div>
            </div>
            <div class="box"><img src="/admin/siteqr/png?t=@DateTime.UtcNow.Ticks" alt="QR trang web" /></div>
            <div class="bottom">
                <div class="fw-bold fs-5">📱 Quét để bắt đầu tham quan</div>
                <div class="text-muted small mb-2">Scan to explore the campus · 스캔 · 扫码 · スキャン</div>
                <div class="langs">🇻🇳 🇬🇧 🇯🇵 🇰🇷 🇨🇳</div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card p-4">
            <label class="form-label fw-semibold">Liên kết trong mã QR</label>
            <div class="input-group mb-2">
                <input class="form-control" id="siteLink" value="@link" readonly />
                <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('siteLink').value)"><i class="bi bi-clipboard"></i></button>
                <a class="btn btn-outline-primary" href="@link" target="_blank"><i class="bi bi-box-arrow-up-right"></i></a>
            </div>
            @if (!reachable)
            {
                <div class="alert alert-danger small mb-2"><i class="bi bi-exclamation-triangle"></i> Liên kết đang là <b>localhost</b> nên điện thoại không mở được. Hãy kết nối Wi-Fi/LAN hoặc bật Tunnel (<code>"Tunnel": {"Enabled": true}</code>) rồi chạy lại.</div>
            }
            else if (tunnel)
            {
                
            }
            else
            {
                <div class="alert alert-info small mb-2"><i class="bi bi-wifi"></i> Đang dùng địa chỉ mạng nội bộ – điện thoại phải bắt <b>cùng Wi-Fi</b> với máy chạy chương trình.</div>
            }
            <div class="d-flex flex-wrap gap-2 mt-2">
                <button class="btn btn-primary" type="button" onclick="window.print()"><i class="bi bi-printer"></i> In poster</button>
                <a class="btn btn-outline-primary" href="/admin/siteqr/png?download=true"><i class="bi bi-download"></i> Tải ảnh QR (PNG)</a>
            </div>
            <hr />
            <p class="small text-muted mb-0">Mã QR của từng điểm (dán tại toà nhà) vẫn ở <a href="/admin/points">Điểm thuyết minh › QR</a>; quét mã đó sẽ mở thẳng trang thuyết minh của điểm.</p>
        </div>
    </div>
</div>
