@model List<NgonNgu>
@{ ViewData["Title"] = "Ngôn ngữ"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="page-title mb-0">Ngôn ngữ, giọng đọc, ngôn ngữ dự phòng</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm ngôn ngữ</a>
</div>
<div class="card">
    <table class="table mb-0">
        <thead><tr><th>Ngôn ngữ</th><th>Trạng thái</th><th>Giọng đọc</th><th>Thêm giọng</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var n in Model)
        {
            <tr>
                <td class="fw-semibold">@n.Co @n.TenNgonNgu <span class="text-muted small">(@n.MaNgonNgu)</span>
                    @if (n.LaNgonNguGoc) { <span class="badge bg-primary">Gốc</span> }
                    @if (n.LaDuPhong) { <span class="badge bg-info text-dark">Dự phòng</span> }</td>
                <td>@if (n.KichHoat) { <span class="badge bg-success">Bật</span> } else { <span class="badge bg-secondary">Tắt</span> }</td>
                <td>
                    @foreach (var g in n.GiongDocs)
                    {
                        <form method="post" asp-action="DefaultVoice" class="d-inline">
                            <input type="hidden" name="maGiong" value="@g.MaGiong" />
                            <button class="btn btn-sm @(g.MacDinh ? "btn-primary" : "btn-outline-secondary") mb-1" title="Đặt làm mặc định">@g.TenGiongAPI (@g.GioiTinh)</button>
                        </form>
                    }
                </td>
                <td>
                    <form method="post" asp-action="AddVoice" asp-route-id="@n.MaNgonNgu" class="d-flex gap-1">
                        <input name="tenGiongAPI" class="form-control form-control-sm" placeholder="VD: @(n.GiongDocs.FirstOrDefault()?.TenGiongAPI ?? "en-US-Standard-D")" />
                        <select name="gioiTinh" class="form-select form-select-sm" style="width:80px"><option value="Nu">Nữ</option><option value="Nam">Nam</option></select>
                        <button class="btn btn-sm btn-outline-primary">+</button>
                    </form>
                </td>
                <td class="text-end text-nowrap">
                    @if (!n.LaNgonNguGoc)
                    {
                        <form method="post" asp-action="Toggle" asp-route-id="@n.MaNgonNgu" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(n.KichHoat ? "Tắt" : "Bật")</button></form>
                        @if (!n.LaDuPhong && n.KichHoat)
                        {
                            <form method="post" asp-action="Fallback" asp-route-id="@n.MaNgonNgu" class="d-inline"><button class="btn btn-sm btn-outline-info">Đặt làm dự phòng</button></form>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<p class="small text-muted mt-2">Giọng đọc là mã vùng (vi-VN, en-US, …) mà app dùng để đọc bằng giọng của điện thoại; bấm vào để đặt làm mặc định. Tiếng Việt và ngôn ngữ dự phòng không thể tắt.</p>
