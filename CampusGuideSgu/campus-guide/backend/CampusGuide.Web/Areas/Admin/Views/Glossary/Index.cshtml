@model List<ThuatNgu>
@{ ViewData["Title"] = "Thuật ngữ"; List<NgonNgu> langs = ViewBag.Langs; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="page-title mb-0">Bảng thuật ngữ</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm thuật ngữ</a>
</div>
<p class="text-muted">Tên riêng của trường được giữ đúng khi dịch tự động. Để trống bản dịch nghĩa là giữ nguyên tên tiếng Việt.</p>
<div class="card">
    <table class="table table-hover mb-0">
        <thead><tr><th>Từ gốc</th>@foreach (var l in langs) { <th>@l.MaNgonNgu</th> }<th class="text-end"></th></tr></thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td class="fw-semibold">@t.TuGoc<div class="small text-muted">@t.GhiChu</div></td>
                @foreach (var l in langs) { <td class="small">@(t.BanDichs.FirstOrDefault(b => b.MaNgonNgu == l.MaNgonNgu)?.BanDich ?? "–")</td> }
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@t.MaThuatNgu"><i class="bi bi-pencil"></i></a>
                    <form method="post" asp-action="Reapply" asp-route-id="@t.MaThuatNgu" class="d-inline"><button class="btn btn-sm btn-outline-primary" title="Đánh dấu bản dịch cũ cần dịch lại">Áp dụng lại</button></form>
                    <form method="post" asp-action="Delete" asp-route-id="@t.MaThuatNgu" class="d-inline" onsubmit="return confirm('Xóa thuật ngữ?')"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<form method="post" asp-action="Import" enctype="multipart/form-data" class="card p-3 mt-3" style="max-width:640px">
    <h6>Nhập từ file CSV (UTF-8)</h6>
    <p class="small text-muted mb-2">Dòng đầu là tiêu đề: <code>tu_goc,en,ja,ko,zh-CN</code>. Trong Excel chọn <i>Lưu thành → CSV UTF-8</i>.</p>
    <div class="d-flex gap-2"><input type="file" name="file" accept=".csv" class="form-control" /><button class="btn btn-outline-primary">Nhập</button></div>
</form>
