@model LoginVm
@{
    Layout = null;
    // Lỗi từ AccountController.Login (sai mật khẩu, tài khoản khoá, thiếu email...) hiện ở dòng trạng thái.
    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Distinct().ToList();
    var statusClass = errors.Count > 0 ? "status is-error" : "status";
}
@* UC12 – Trang đăng nhập Admin, giao diện Halloween (bật/tắt đêm, đèn pin soi mật khẩu).
   Ảnh, font, script nằm ở wwwroot/admin-login/; thẻ <base> cho mọi đường dẫn tương đối trỏ về đó. *@
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập – CampusGuide</title>
    <base href="@Url.Content("~/admin-login/")" />
    <link rel="stylesheet" href="style.css?v=cg1" />
    <style>
      /* Phông chữ thường thay cho phông Halloween, đọc rõ tiếng Việt */
      :root, h1, .scene-copy h2, input, button, a, p, label {
        font-family: "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif !important;
        letter-spacing: normal !important;
      }
      /* Chữ mật khẩu hiện ra khi soi đèn pin: phông thường, màu đậm cho dễ đọc */
      .password-reveal, .password-reveal span {
        font-family: "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif !important;
        font-size: 16px !important;
        font-weight: 600 !important;
        color: #172b33 !important;
      }
      /* Nền ảnh trường SGU: đặt ảnh vào wwwroot/admin-login/images/sgu.jpg */
      .page-landscape, .scene-panel .landscape-scene {
        background: url("images/sgu.jpg") center / cover no-repeat, url("images/sgu.png") center / cover no-repeat, url("images/sgu.jpeg") center / cover no-repeat, url("images/sgu.webp") center / cover no-repeat, #16374b !important;
      }
      .page-landscape .scene-land, .scene-panel .scene-land, .scene-panel .scene-sky-objects { display: none !important; }
      /* Ban ngày: phủ mờ nhẹ cho chữ dễ đọc; ban đêm: phủ tối tím */
      .page-landscape::before, .scene-panel .landscape-scene::before {
        background: linear-gradient(rgb(10 30 45 / 15%), rgb(10 30 45 / 35%)) !important;
        opacity: 1 !important;
      }
      body.night .page-landscape::before, body.night .scene-panel .landscape-scene::before {
        background: linear-gradient(rgb(22 14 37 / 72%), rgb(20 15 34 / 82%)) !important;
      }
      .page-landscape { filter: blur(2px); transform: scale(1.02); }
    </style>
    <script src="resources.js?v=cg1" defer></script>
    <script src="script.js?v=cg1" defer></script>
    <script src="spider.js?v=cg1" defer></script>
    <script src="wolf.js?v=cg1" defer></script>
  </head>
  <body>
    <div class="landscape-scene page-landscape" aria-hidden="true">
      <img class="scene-land scene-day" src="images/background-day.svg?v=clouds-1" alt="" />
      <img class="scene-land scene-night" src="images/background-night.svg?v=clouds-1" alt="" />
      <div class="sky-flight" aria-hidden="true">
        <span class="sky-bat bat-1">
          <span class="flyer-facing">
            <span data-svg="images/bat.svg" aria-hidden="true"></span>
          </span>
        </span>
        <span class="sky-bat bat-2">
          <span class="flyer-facing">
            <span data-svg="images/bat.svg" aria-hidden="true"></span>
          </span>
        </span>
        <span class="sky-bat bat-3">
          <span class="flyer-facing">
            <span data-svg="images/bat.svg" aria-hidden="true"></span>
          </span>
        </span>
        <span class="sky-bat bat-4">
          <span class="flyer-facing">
            <span data-svg="images/bat.svg" aria-hidden="true"></span>
          </span>
        </span>
        <span class="sky-bat bat-5">
          <span class="flyer-facing">
            <span data-svg="images/bat.svg" aria-hidden="true"></span>
          </span>
        </span>
        <span class="sky-bat bat-6">
          <span class="flyer-facing">
            <span data-svg="images/bat.svg" aria-hidden="true"></span>
          </span>
        </span>
        <span class="sky-witch">
          <span class="flyer-facing">
            <img src="images/witch.svg?v=1" alt="" width="3600" height="3400" draggable="false">
          </span>
        </span>
      </div>
    </div>

    <div class="login-shell">
      <div class="halloween-vines" id="halloween-vines" aria-hidden="true"></div>
      <main class="login-card" aria-labelledby="login-title">
        <section class="scene-panel" aria-labelledby="welcome-title">
          <div class="landscape-scene" aria-hidden="true">
            <div class="scene-sky-objects">
              <div class="scene-sun"></div>
              <div class="scene-moon"></div>
            </div>
            <img class="scene-land scene-day" src="images/panel-day.svg?v=responsive-1" alt="" />
            <img class="scene-land scene-night" src="images/panel-night.svg?v=responsive-1" alt="" />
            <div class="sky-flight" aria-hidden="true">
              <span class="sky-bat bat-1">
                <span class="flyer-facing">
                  <span data-svg="images/bat.svg" aria-hidden="true"></span>
                </span>
              </span>
              <span class="sky-bat bat-2">
                <span class="flyer-facing">
                  <span data-svg="images/bat.svg" aria-hidden="true"></span>
                </span>
              </span>
              <span class="sky-bat bat-3">
                <span class="flyer-facing">
                  <span data-svg="images/bat.svg" aria-hidden="true"></span>
                </span>
              </span>
            </div>
          </div>
          <div class="summit-stage" aria-hidden="true"></div>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false" aria-label="Bật đêm Halloween">
            <span class="theme-toggle-thumb" aria-hidden="true"></span>
            <span data-svg="images/icon-sun.svg" aria-hidden="true"></span>
            <span data-svg="images/icon-moon.svg" aria-hidden="true"></span>
          </button>
          <div class="scene-copy">
            <h2 id="welcome-title">CampusGuide</h2>
            <p>Trang quản trị nội dung thuyết minh đa ngôn ngữ – Trường Đại học Sài Gòn.</p>
          </div>
        </section>
        <section class="form-panel">
          <form class="login-form" id="login-form" method="post" action="@Url.Action("Login", "Account", new { area = "Admin" })">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <h1 id="login-title">Đăng nhập</h1>
            <div class="field">
              <label class="sr-only" for="email">Email</label>
              <input id="email" name="Email" type="email" value="@Model.Email" placeholder="Email" autocomplete="username" required autofocus />
              <div class="email-owl" id="email-owl" aria-hidden="true">
                <span data-svg="images/owl.svg" aria-hidden="true"></span>
              </div>
            </div>
            <div class="field password">
              <label class="sr-only" for="password">Mật khẩu</label>
              <input id="password" name="MatKhau" type="password" placeholder="Mật khẩu" autocomplete="current-password" required />
              <button class="eye" id="show-password" type="button" aria-label="Hiện mật khẩu" aria-pressed="false" aria-controls="password">
                <img src="images/icon-eye.svg" alt="" width="18" height="18" />
              </button>
            </div>
            <a class="text-action forgot" id="forgot-password" href="@Url.Action("Forgot", "Account", new { area = "Admin" })">Quên mật khẩu?</a>
            <button class="submit" type="submit">
              <span>Đăng nhập</span> <img src="images/icon-arrow.svg" alt="" width="17" height="17" />
            </button>
            <p class="@statusClass" id="status" role="status" aria-live="polite">@string.Join(" ", errors)</p>
          </form>
        </section>
      </main>
    </div>

    <canvas id="halloween-spider" aria-hidden="true"></canvas>

    <div class="flash-beam" id="flash-beam" aria-hidden="true"></div>

    <div class="password-reveal" id="password-reveal" aria-hidden="true">
      <span id="reveal-text"></span>
    </div>

    <div class="flashlight" id="flashlight" aria-hidden="true">
      <img src="images/flashlight.svg" alt="" width="33" height="33" />
    </div>
    
  
  </body>
</html>

