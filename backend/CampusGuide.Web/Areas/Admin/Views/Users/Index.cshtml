@model List<NguoiDung>
@{ ViewData["Title"] = "Tài khoản"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="page-title mb-0">Tài khoản và phân quyền</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Thêm tài khoản</a>
</div>
<div class="card">
    <table class="table table-hover mb-0">
        <thead><tr><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Ngày tạo</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td class="fw-semibold">@u.HoTen</td><td>@u.Email</td><td>@u.VaiTro?.TenVaiTro</td>
                <td>@Ui.Badge(u.TrangThai) @if (u.KhoaDen > DateTime.UtcNow) { <span class="badge bg-warning text-dark">Tạm khóa</span> }</td>
                <td class="small">@u.NgayTao.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@u.MaND"><i class="bi bi-pencil"></i></a>
                    <form method="post" asp-action="ToggleLock" asp-route-id="@u.MaND" class="d-inline">
                        <button class="btn btn-sm btn-outline-warning">@(u.TrangThai == "HoatDong" ? "Khóa" : "Mở khóa")</button></form>
                    <form method="post" asp-action="ResetPassword" asp-route-id="@u.MaND" class="d-inline" onsubmit="return confirm('Đặt lại mật khẩu cho tài khoản này?')">
                        <button class="btn btn-sm btn-outline-danger">Đặt lại mật khẩu</button></form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
